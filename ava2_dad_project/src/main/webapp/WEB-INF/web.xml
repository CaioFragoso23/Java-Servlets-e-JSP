<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>ava2_dad_project</display-name>
  <!-- Servlet Hello World! -->
  <servlet-mapping>
  	<servlet-name>AloMundo</servlet-name>
  	<url-pattern>/AloMundo</url-pattern>
  </servlet-mapping>
  <servlet>
  	<servlet-name>AloMundo</servlet-name>
  	<servlet-class>ava2_dad_project.AloMundo</servlet-class>
  </servlet>
  
  <!-- Servlet Calculo  -->
  <servlet-mapping>
  <servlet-name>CalculoServlet</servlet-name>
  <url-pattern>/Calculo</url-pattern>
  </servlet-mapping>
  <servlet>
  	 <servlet-name>CalculoServlet</servlet-name>
  	 <servlet-class>ava2_dad_project.Calculo</servlet-class>
  </servlet>
  
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.xhtml</welcome-file>
    <welcome-file>default.html</welcome-file>
    
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file><welcome-file>default.xhtml</welcome-file>
  </welcome-file-list>
</web-app>